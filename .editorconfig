root = true

# All files
[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# C# files
[*.cs]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true

# C# project and solution files
[*.{csproj,sln,props,targets}]
indent_style = space
indent_size = 2

# TypeScript, JavaScript, Vue, JSON, YAML, HTML, CSS
[*.{ts,tsx,js,jsx,vue,json,jsonc,yaml,yml,html,css,scss}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# Makefiles require tabs
[Makefile]
indent_style = tab
