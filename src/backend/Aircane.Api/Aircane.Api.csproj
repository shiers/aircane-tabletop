<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Aircane.Api</RootNamespace>
    <AssemblyName>Aircane.Api</AssemblyName>
    <UserSecretsId>3736f50c-50b9-4cf2-9740-fa5e3e54eacf</UserSecretsId>
  </PropertyGroup>

  <!--
    Single source of truth for the app version: the repo-root VERSION file.
    scripts/bump-version.(sh|ps1) edits only that file; this target reads it so
    the published binary always carries the shared version. Falls back to 0.0.0
    if the file is missing (e.g. building the project in isolation).
  -->
  <PropertyGroup>
    <_VersionFile>$(MSBuildThisFileDirectory)..\..\..\VERSION</_VersionFile>
    <Version Condition="Exists('$(_VersionFile)')">$([System.IO.File]::ReadAllText('$(_VersionFile)').Trim())</Version>
    <Version Condition="!Exists('$(_VersionFile)')">0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aircane.Application\Aircane.Application.csproj" />
    <ProjectReference Include="..\Aircane.Infrastructure\Aircane.Infrastructure.csproj" />
    <ProjectReference Include="..\Aircane.Workers\Aircane.Workers.csproj" />
  </ItemGroup>

</Project>
