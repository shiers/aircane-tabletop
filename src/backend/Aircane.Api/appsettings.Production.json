{
  // ─────────────────────────────────────────────────────────────────────────
  // Aircane Tabletop - Production Configuration
  //
  // This profile is used for local release runs (without Docker) and as the
  // base for containerized deployments.
  //
  // Required environment variables (override these at runtime):
  //   ConnectionStrings__DefaultConnection  - PostgreSQL connection string
  //   Jwt__SigningKey                        - min 32-char secret for session tokens
  //
  // Optional overrides:
  //   Storage__DocumentsPath                - app-generated content directory (default: ./data)
  //   Ai__Provider                          - AI provider name (OpenAi, AzureOpenAi, Ollama, etc.)
  //   Embeddings__Provider                  - Embedding provider name
  //   ASPNETCORE_URLS                       - listen URL (default: http://+:8080)
  // ─────────────────────────────────────────────────────────────────────────
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Aircane.Infrastructure.Ai": "Information",
      "Aircane.Infrastructure.Library": "Information",
      "Aircane.Infrastructure.Sessions": "Information",
      "Aircane.Api.Authorization": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true,
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=aircane;Username=aircane;Password=CHANGE_ME"
  },
  "Storage": {
    "DocumentsPath": "./data"
  },
  "Library": {
    "MaxUploadSizeBytes": 104857600
  },
  "Embeddings": {
    "Provider": "Ollama",
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "nomic-embed-text"
    }
  },
  "Ai": {
    "Provider": "Ollama"
  },
  "Jwt": {
    "ExpiryHours": 24
  }
}
