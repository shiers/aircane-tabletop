{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Aircane.Infrastructure.Ai": "Information",
      "Aircane.Infrastructure.Library": "Information",
      "Aircane.Infrastructure.Sessions": "Information",
      "Aircane.Api.Authorization": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true,
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "Storage": {
    "DocumentsPath": "./data/documents"
  },
  "Library": {
    "MaxUploadSizeBytes": 104857600
  },
  "Embeddings": {
    "Provider": "Fake",
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "nomic-embed-text"
    }
  },
  "Ai": {
    "Provider": "Ollama",
    "OpenAi": {
      "Model": "gpt-4o-mini"
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "llama3.1:8b"
    }
  },
  "Jwt": {
    "ExpiryHours": 24
  }
}
