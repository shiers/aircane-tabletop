<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Aircane.Workers</RootNamespace>
    <AssemblyName>Aircane.Workers</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aircane.Application\Aircane.Application.csproj" />
    <ProjectReference Include="..\Aircane.Domain\Aircane.Domain.csproj" />
    <ProjectReference Include="..\Aircane.Infrastructure\Aircane.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in rules content bundles (Phase 10). Each subfolder is a bundle with a manifest.json.
         Embed every file under the bundle tree (manifests, markdown content, license texts) so new
         content files are picked up automatically without editing this project file. -->
    <EmbeddedResource Include="Resources\builtin\**\*" />
  </ItemGroup>

</Project>
