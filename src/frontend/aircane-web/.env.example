# Aircane Web - environment variables.
#
# Copy this file to `.env.local` (not committed) and edit it. Vite reads these when the dev server starts or when
# `npm run build` runs, so restart or rebuild after changing one. See docs/setup/feature-flags.md.

# Base URL of the API. Leave empty to use the same origin (the dev server proxies /api and /hubs to the backend).
# VITE_API_BASE_URL=

# Feature flag: show the Characters feature (the Characters page, importing, and assigning characters to players).
# Off by default: character management is a stretch goal, so the UI is hidden and /characters redirects to the
# dashboard. The code, backend endpoints and stored data are untouched. Accepted "on" values: true, 1, yes, on.
VITE_ENABLE_CHARACTERS=false
